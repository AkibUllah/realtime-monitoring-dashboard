# Number of simulated fleet nodes (in addition to the real host collected via psutil)
FLEET_SIZE=6
# Seed for the fleet simulator so demos are reproducible
FLEET_SEED=42
# Seconds between collection ticks
COLLECT_INTERVAL_SECONDS=2
# Samples kept per (node, metric) in memory; 1800 x 2s = 1 hour
RING_CAPACITY=1800
# Optional SQLite persistence (leave empty to disable). Loads recent history on startup.
SQLITE_PATH=./data/metrics.db
# Collect real host metrics with psutil (set false in CI containers without /proc access)
HOST_COLLECTOR_ENABLED=true
# Start the background collector loop (tests set this to false and tick manually)
COLLECTOR_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO

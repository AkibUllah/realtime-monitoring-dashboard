{
  "name": "realtime-monitoring-dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -e \"./backend[dev]\" && cp -n backend/.env.example backend/.env; cd frontend && npm ci --no-audit --no-fund",
  "postStartCommand": "bash .devcontainer/start-demo.sh",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Dashboard",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "API docs (/docs)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
